# Server Configuration
PORT=5000
NODE_ENV=development

# AWS MySQL Database Configuration
DB_HOST=your-aws-mysql-endpoint.rds.amazonaws.com
DB_USER=your_database_user
DB_PASSWORD=your_database_password
